# AppArmor profile for Agentic Desktop installed by scripts/install-local.ts (SPEC 29.2).
# Ubuntu 24.04 and later stop unconfined apps from creating user namespaces, which Chromium's
# sandbox needs. Like the profiles Ubuntu ships for Chrome, VS Code and Obsidian, this one allows
# everything and only gives the app the right to create them, so the sandbox can start.

abi <abi/5.0>,
include <tunables/global>

profile agentic-desktop @{HOME}/.local/opt/agentic-desktop/agentic-desktop-bin flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/agentic-desktop>
}
